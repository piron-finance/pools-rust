  {
    "function_v0": {
      "doc": "Pulls `amount` from `from` into custody.\\n\\n`from` authorises the transfer; the manager authorises that it should happen at\\nall. Both signatures are required, which is what stops either side moving money\\nalone.",
      "name": "take",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "What the escrow holds on the protocol's books.\\n\\nDeliberately the tracked figure \\xe2\\x80\\x94 everything that came in through `take` less\\neverything released \\xe2\\x80\\x94 and not the token balance. NAV is struck on this, so a raw\\nbalance would let anyone move the price of a pool by transferring tokens straight\\nto the address: seed a new pool with the minimum, donate to push the price up, and\\nlater depositors round down to fewer shares. Tokens that arrive that way are\\ninvisible here until someone credits them deliberately with `sync_untracked`.",
      "name": "balance",
      "inputs": [],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "",
