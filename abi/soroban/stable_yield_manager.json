          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Settles up to `max_items` queued exits, in order, from free cash.\\n\\nFree cash means escrow balance above the reserve floor \\xe2\\x80\\x94 a pool must not empty\\nitself serving the queue and leave nothing for the next redemption.",
      "name": "process_withdrawals",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "max_items",
          "type_": "u32"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "u32",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Records a coupon paid on a holding.\\n\\nThe cash comes into the escrow and the instrument's clock advances, so NAV stops\\naccruing the coupon it has now actually received and starts accruing the next one.",
      "name": "record_instrument_coupon",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "index",
