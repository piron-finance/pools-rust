  {
    "function_v0": {
      "doc": "Credits tokens that reached the reserve without passing through a tracked path.\\n\\n`receive_yield` is the only crediting inflow and it *pulls* from a registered\\nsource. The fee manager pays the reserve's share of a distribution by pushing a\\nplain transfer, which no tracked path sees \\xe2\\x80\\x94 so without this the money sits at the\\naddress, invisible to every `balance` check that governs loans, deployments and\\nshortfall cover, and `receive_yield` cannot retroactively credit it.\\n\\nPermissionless on purpose: it only recognises funds already held, so there is\\nnothing to gain by calling it and real harm in the reserve sitting insolvent on\\npaper because nobody did.",
      "name": "sync_untracked",
      "inputs": [],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Absorbs a shortfall so it lands on the protocol rather than on whichever investor\\nhappened to redeem last.\\n\\nThis may take the reserve below its floor, deliberately.",
