  {
    "function_v0": {
      "doc": "Names the manager permitted to move these funds. Callable once, by the deployer.\\n\\nOnce set it cannot change: an escrow that could be re-pointed at a new manager\\nwould be an escrow that does not segregate anything.",
      "name": "bind_manager",
      "inputs": [
        {
          "doc": "",
          "name": "manager",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Creates the escrow for one asset. The manager is bound separately, because the\\ntwo contracts reference each other and one has to exist first.",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "deployer",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "asset",
          "type_": "address"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Names the contract permitted to upgrade this one. Callable once.\\n\\nOne-way on purpose: a contract whose upgrader could be repointed has no timelock,\\nonly the appearance of one.",
      "name": "bind_upgrader",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "upgrader",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Credits an untracked balance to the pool. Manager only.\\n\\nA donation, a misdirected transfer or a token airdrop is not free money until\\nsomebody decides it is. This makes that a deliberate act with an event attached\\nrather than a silent move in the share price.",
      "name": "sync_untracked",
      "inputs": [],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": "error"
          }
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Addresses permitted to drive a pool.\\n\\nA placeholder for the full seven-role `AccessManager`: these are the roles a pool's own\\nlifecycle needs, resolved once at construction rather than looked up per call.",
      "lib": "",
      "name": "Roles",
      "fields": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "emergency",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "operator",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "spv",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "treasury",
          "type_": "address"
        },
        {
          "doc": "The only address permitted to replace this pool's bytecode, bound at construction.\\n\\nSoroban claims upgrade authority once and irrevocably, so an unbound slot is not\\nmerely \"not upgradeable yet\" \\xe2\\x80\\x94 it is a slot anyone with the admin role can claim\\nfor themselves, permanently, on a pool already holding funds. Binding it in the\\nconstructor closes that window rather than leaving it to an operational step\\nsomebody has to remember.\\n\\nThe factory overwrites whatever a pool creator passes with the timelock it was\\nconfigured with, so this cannot be used to name a different authority.",
          "name": "upgrader",
          "type_": "address"
        }
      ]
    }
  },
