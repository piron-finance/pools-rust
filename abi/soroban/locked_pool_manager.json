      "doc": "Names the contract permitted to upgrade this one. Callable once.\\n\\nOne-way on purpose: a contract whose upgrader could be repointed has no timelock,\\nonly the appearance of one.",
      "name": "bind_upgrader",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
