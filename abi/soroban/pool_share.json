    "function_v0": {
      "doc": "SEP-41 approval, expiring at `expiration_ledger`.\\n\\nThe expiry is honoured rather than discarded: a caller who sets one is stating\\nwhen the allowance should stop working, and an implementation that ignores it\\nleaves a permanent approval behind a signature that did not grant one.",
      "name": "approve",
      "inputs": [
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "spender",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "expiration_ledger",
          "type_": "u32"
        }
      ],
